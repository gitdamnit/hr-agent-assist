# ============================================
# HR CARE — Environment Variables
# ============================================

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/hr_care

# --- LLM Provider (swappable) ---
# Provider name: opencode_go | openai | openrouter | groq | custom
LLM_PROVIDER=opencode_go

# API key for the selected provider
LLM_API_KEY=

# Base URL for the provider API
# OpenCode Go: https://opencode.ai/zen/go/v1
# OpenAI: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=https://opencode.ai/zen/go/v1

# Default model to use
# OpenCode Go models: deepseek-v4-pro, deepseek-v4-flash, qwen3.5-plus, qwen3.6-plus, glm-5, glm-5.1, kimi-k2.5, kimi-k2.6, mimo-v2.5, mimo-v2.5-pro, minimax-m2.5, minimax-m2.7
# OpenAI models: gpt-4o, gpt-4o-mini, o1, o1-mini
LLM_MODEL=deepseek-v4-pro

# Comma-separated fallback models (tried in order if primary fails)
LLM_MODEL_FALLBACKS=deepseek-v4-flash,qwen3.5-plus

# Request timeout in milliseconds (default: 30000)
LLM_TIMEOUT_MS=30000

# Max completion tokens per request (default: 4096)
LLM_MAX_TOKENS=4096

# --- Backward Compatibility ---
# These are still supported if LLM_* vars are not set
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# --- Session ---
SESSION_SECRET=
